# Copy to dev/backend/.env and fill in. .env is git-ignored; never commit real keys.

# Chatbot (Groq). Empty = the chatbot runs in offline "guide" mode (FAQ + navigation, no LLM).
# Extra keys are optional: they are used in turn, and a rate-limited key passes the request to the next one.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Must be a model your key can use (list them: GET https://api.groq.com/openai/v1/models).
# Tested 2026-10-31: qwen/qwen3.8-27b works (Marathi/Hindi/English, JSON replies). llama-3.3-70b-versatile is no longer offered.
GROQ_MODEL=qwen/qwen3.8-27b

# Speech (Gnani Vachana). ONE key covers speech-to-text and text-to-speech. Empty = voice features stay hidden.
GNANI_API_KEY=
# Optional overrides (empty = the defaults below, from https://docs.gnani.ai):
#   GNANI_STT_URL=https://api.vachana.ai/stt/v3
#   GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
#   GNANI_STT_MODEL=prisma-v3.0
#   GNANI_TTS_MODEL=timbre-v2.5
#   GNANI_TTS_VOICE=Nalini            (one voice for every language), or per language:
#   GNANI_TTS_VOICE_MR= / GNANI_TTS_VOICE_HI= / GNANI_TTS_VOICE_EN=   (names from Gnani's voice catalog)
GNANI_STT_URL=
GNANI_TTS_URL=

# 1 = FastAPI also serves the built frontend (dev/frontend/dist) at http://localhost:8000
SERVE_FRONTEND=0
